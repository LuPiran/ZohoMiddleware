# ============================================
# ARQUIVO DE EXEMPLO - COPIE PARA .env E PREENCHA
# ============================================

# ============================================
# CONFIGURAÇÃO DO SERVIDOR
# ============================================
NODE_ENV=production
PORT=3000

# ============================================
# CONFIGURAÇÃO DO ZOHO CRM
# ============================================
# Obtenha essas credenciais em: https://api-console.zoho.com/
ZOHO_CLIENT_ID=seu_client_id_aqui
ZOHO_CLIENT_SECRET=seu_client_secret_aqui
ZOHO_REFRESH_TOKEN=seu_refresh_token_aqui

# URLs do Zoho (geralmente não precisa alterar)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_BASE=https://www.zohoapis.com

# Configuração do Módulo Customizado do Zoho
# IMPORTANTE: Configure o nome exato do módulo que contém os usuários
# Exemplos: CustomModule45, CustomModule1, Usu_rio_Portal_Consultor
ZOHO_MODULE_NAME=CustomModule45

# Nomes dos campos no módulo customizado
# Ajuste conforme os nomes dos campos no seu módulo do Zoho
ZOHO_EMAIL_FIELD=Email
ZOHO_SENHA_FIELD=Senha

# ============================================
# CONFIGURAÇÃO DE SEGURANÇA (JWT)
# ============================================
# IMPORTANTE: Gere uma chave secreta forte e única!
# Use no terminal: openssl rand -base64 32
# Ou gere online: https://generate-secret.vercel.app/32
JWT_SECRET=sua-chave-secreta-super-segura-altere-em-producao

# Tempo de expiração do token JWT
# Formatos aceitos: 1h, 24h, 7d, 30d, etc.
JWT_EXPIRES_IN=24h
