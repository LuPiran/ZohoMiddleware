PORT=3000
NODE_ENV=development

# JWT Configuration (gere um valor aleatório com 32+ caracteres)
JWT_SECRET=change_me_generate_a_long_random_secret

# Zoho API Configuration
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_REDIRECT_URI=http://localhost:3000/auth/callback
ZOHO_MODULE_NAME=
ZOHO_EMAIL_FIELD=Email
ZOHO_SENHA_FIELD=Senha
ZOHO_STATUS_FIELD=Ativo
ZOHO_NOME_FIELD=Name
ZOHO_FOTO_FIELD=Record_Image
ZOHO_ULTIMO_ACESSO_FIELD=Ultimo_acesso
ZOHO_ULTIMO_LOGIN_FIELD=Ultimo_Login

# Frontend URL (produção: https://portal.autofullall.com)
FRONTEND_URL=https://portal.autofullall.com

# Microsoft Entra ID (SPA / PKCE — sem client secret)
ENTRA_CLIENT_ID=
ENTRA_TENANT_ID=
ENTRA_ISSUER=

# CEP API Configuration
CEP_PROVIDER=contracted
CEP_API_URL=
CEP_API_PASSWORD=
CEP_API_TIMEOUT_MS=10000

# AWS / DynamoDB — Leads Médicos
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_LEADS_TABLE=portal_leads_medicos
DYNAMODB_LEADS_ZOHO_ID_INDEX=gsi_zoho
DYNAMODB_LEADS_ZOHO_ID_ATTR=idZoho
DYNAMODB_LEADS_CONSULTOR_INDEX=gsi_consultor
DYNAMODB_LEADS_CONSULTOR_ATTR=consultorId
DYNAMODB_LEADS_CONSULTOR_SK_ATTR=entradaEm
DYNAMODB_CONSULTORES_TABLE=portal_consultores
DYNAMODB_CONSULTORES_EMAIL_INDEX=gsi_email
DYNAMODB_CONSULTORES_EMAIL_ATTR=email
# Segredo compartilhado com o Workflow/Webhook do Zoho
ZOHO_LEADS_WEBHOOK_SECRET=change_me_long_random_webhook_secret

# Módulo e campos do lead médico no Zoho CRM
ZOHO_LEADS_MODULE=Leads_M_dicos
ZOHO_LEAD_STATUS_FIELD=Status
ZOHO_LEAD_CONSULTOR_FIELD=Consultor_Tegra
ZOHO_LEAD_DATA_QUALIFICADO_FIELD=Data_Lead_qualifica_o
ZOHO_LEAD_DATA_INTERESSE_FIELD=Data_Lead_Com_Interesse
ZOHO_LEAD_DATA_SEM_CONTATO_FIELD=Data_lead_sem_contato
ZOHO_LEAD_DATA_SEM_INTERESSE_FIELD=Data_lead_sem_interesse
ZOHO_LEAD_DATA_1A_FIELD=Data_1_Tentativa
ZOHO_LEAD_OBS_1A_FIELD=Tentativa_1
ZOHO_LEAD_STATUS_1A_FIELD=Status_1_Tentativa
ZOHO_LEAD_DATA_2A_FIELD=Data_2_Tentativa
ZOHO_LEAD_OBS_2A_FIELD=Tentativa_2
ZOHO_LEAD_STATUS_2A_FIELD=Status_2_Tentativa
ZOHO_LEAD_DATA_3A_FIELD=Data_3_Tentativa
ZOHO_LEAD_OBS_3A_FIELD=Tentativa_3
ZOHO_LEAD_STATUS_3A_FIELD=Status_3_Tentativa
ZOHO_LEAD_ADD_2A_FIELD=Adicionar_2_Tentativa
ZOHO_LEAD_ADD_3A_FIELD=Adicionar_3_Tentativa
ZOHO_LEAD_PROTOCOLO_FIELD=Protocolo_Portal

# Sessão "4ª Tentativas de Contato" — solicitada pelo consultor, sem aprovação
# (requer criar a seção + campos + valores de status no Zoho antes de usar)
ZOHO_LEAD_DATA_4A_FIELD=Data_4_Tentativa
ZOHO_LEAD_OBS_4A_FIELD=Tentativa_4
ZOHO_LEAD_STATUS_4A_FIELD=Status_4_Tentativa
ZOHO_LEAD_ADD_4A_FIELD=Adicionar_4_Tentativa
ZOHO_LEAD_MOTIVO_4A_FIELD=Motivo_4_Tentativa

# Rejeição de oferta (recusa ou 48h sem aceite) e "Lead Sem Tratativa"
# (requer criar os valores de status "Lead Rejeitado"/"Lead Sem Tratativa"
# e os campos de data abaixo no Zoho antes de usar)
ZOHO_LEAD_DATA_REJEITADO_FIELD=Data_Lead_Rejeitado
ZOHO_LEAD_DATA_SEM_TRATATIVA_FIELD=Data_Lead_Sem_Tratativa

# Sessão "Distribuição e SLA" — espelha no Zoho o que o Portal decidiu na
# distribuição/aceite do lead (visibilidade só, o roteamento em si roda no Portal)
ZOHO_LEAD_DIST_CONSULTOR_NOME_FIELD=Dist_Consultor_Nome
ZOHO_LEAD_DIST_CONSULTOR_EMAIL_FIELD=Dist_Consultor_Email
ZOHO_LEAD_DIST_CONSULTOR_ID_FIELD=Dist_Consultor_Id_Portal
ZOHO_LEAD_DIST_DATA_ATRIBUICAO_FIELD=Dist_Data_Atribuicao
ZOHO_LEAD_DIST_DATA_CHECKIN_FIELD=Dist_Data_Checkin
ZOHO_LEAD_DIST_REGIAO_FIELD=Dist_Regiao
ZOHO_LEAD_DIST_GEO_METODO_FIELD=Dist_Geo_Metodo
ZOHO_LEAD_DIST_FILA_FIELD=Dist_Fila
ZOHO_LEAD_DIST_STATUS_FIELD=Dist_Status
ZOHO_LEAD_DIST_RODADAS_FIELD=Dist_Rodadas
# Log de erro de geocodificação/distribuição, direto no Zoho (Multi-linhas).
# Sempre preenchido — mensagem de erro real, ou "Sem erros..." quando deu tudo certo.
ZOHO_LEAD_DIST_ERRO_SYNC_FIELD=Dist_Erro_Sync
# Dist_DDD não tem variável — sem uso pelo código (inferência por DDD do
# desenho antigo nunca foi reimplementada no Portal)

# Unicidade do protocolo (opcional — se o GSI não existir, o portal faz scan)
DYNAMODB_LEADS_PROTOCOLO_INDEX=gsi_protocolo
DYNAMODB_LEADS_PROTOCOLO_ATTR=protocolo

# Zoho WorkDrive — evidências das tentativas (Self Client + refresh token)
ZOHO_WORKDRIVE_CLIENT_ID=
ZOHO_WORKDRIVE_CLIENT_SECRET=
ZOHO_WORKDRIVE_REFRESH_TOKEN=
ZOHO_WORKDRIVE_FOLDER_ID=8uwd527d3a78def86494e8fd6b959cbb2bc8d
ZOHO_WORKDRIVE_API_BASE=https://www.zohoapis.com/workdrive/api/v1
# ZOHO_WORKDRIVE_ACCOUNTS_URL=https://accounts.zoho.com
# Preview das imagens no portal (Preview Engine do Zoho)
# ZOHO_WORKDRIVE_PREVIEW_BASE=https://previewengine-accl.zohoexternal.com/image/WD
# Se não definir ZOHO_WORKDRIVE_REFRESH_TOKEN, usa ZOHO_REFRESH_TOKEN (CRM)

# Fila SLA (minutos para aceitar a oferta). Regra de negócio: 48h = 2880.
# Recusa ou estouro deste prazo agora ENCERRA o lead como "Lead Rejeitado"
# (não é mais reofertado ao próximo consultor da fila).
SLA_OFFER_MINUTES=2880

# E-mail transacional da oferta SLA: none | microsoft | resend
# Microsoft Graph: app confidencial (NÃO usar o SPA PKCE) com permissão Mail.Send
# MAIL_FROM deve ser uma caixa do tenant (ex.:  leo.a@example.org)
MAIL_PROVIDER=none
MAIL_FROM=
GRAPH_MAIL_TENANT_ID=
GRAPH_MAIL_CLIENT_ID=
GRAPH_MAIL_CLIENT_SECRET=
RESEND_API_KEY=
