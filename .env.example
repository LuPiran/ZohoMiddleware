PORT=3000
NODE_ENV=development

# JWT Configuration (gere um valor aleatório com 32+ caracteres)
JWT_SECRET=change_me_generate_a_long_random_secret

# Zoho API Configuration
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_REDIRECT_URI=http://localhost:3000/auth/callback
ZOHO_MODULE_NAME=
ZOHO_EMAIL_FIELD=Email
ZOHO_SENHA_FIELD=Senha
ZOHO_STATUS_FIELD=Ativo
ZOHO_NOME_FIELD=Name
ZOHO_FOTO_FIELD=Record_Image
ZOHO_ULTIMO_ACESSO_FIELD=Ultimo_acesso
ZOHO_ULTIMO_LOGIN_FIELD=Ultimo_Login

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Microsoft Entra ID (SPA / PKCE — sem client secret)
ENTRA_CLIENT_ID=
ENTRA_TENANT_ID=
ENTRA_ISSUER=

# CEP API Configuration
CEP_PROVIDER=contracted
CEP_API_URL=
CEP_API_PASSWORD=
CEP_API_TIMEOUT_MS=10000

# AWS / DynamoDB — Leads Médicos
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_LEADS_TABLE=portal_leads_medicos
DYNAMODB_LEADS_ZOHO_ID_INDEX=gsi_zoho
DYNAMODB_LEADS_ZOHO_ID_ATTR=idZoho
DYNAMODB_LEADS_CONSULTOR_INDEX=gsi_consultor
DYNAMODB_LEADS_CONSULTOR_ATTR=consultorId
DYNAMODB_LEADS_CONSULTOR_SK_ATTR=entradaEm
DYNAMODB_CONSULTORES_TABLE=portal_consultores
DYNAMODB_CONSULTORES_EMAIL_INDEX=gsi_email
DYNAMODB_CONSULTORES_EMAIL_ATTR=email
# Segredo compartilhado com o Workflow/Webhook do Zoho
ZOHO_LEADS_WEBHOOK_SECRET=change_me_long_random_webhook_secret
