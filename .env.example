# JWT Configuration
JWT_SECRET=seu_jwt_secret_aqui_minimo_32_caracteres

# Supabase (Backend)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_supabase
# Bucket para anexos: Compra/Recompra/Proposta/Ocorrencia/{protocolo}/arquivos
SUPABASE_FORMULARIOS_BUCKET=tegrapharma
REQUIRE_SUPABASE_AAL2=true

# Supabase (Frontend / Vite)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_supabase

# Zoho API Configuration
ZOHO_CLIENT_ID=seu_client_id_zoho
ZOHO_CLIENT_SECRET=seu_client_secret_zoho
ZOHO_REDIRECT_URI=http://localhost:3000/auth/callback
ZOHO_REFRESH_TOKEN=seu_refresh_token_zoho

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Server Configuration
PORT=3000
NODE_ENV=production
